---
/**
 * Breadcrumb — ordered, aria-current on the last node.
 */
import { locUrl, type Locale } from '../lib/url';
import { t } from '../lib/i18n';

export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  locale: Locale;
  crumbs: Crumb[];
}

const { locale, crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="azt-breadcrumb" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.85rem; margin-block-end: 24px;">
  <ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0;">
    {crumbs.map((c, i) => (
      <li style="display: flex; align-items: center; gap: 8px;">
        {i > 0 && <span aria-hidden="true" style="color: var(--color-ink-500);">/</span>}
        {c.href ? (
          <a href={locUrl(locale, c.href)} style="color: var(--color-ink-700); text-decoration: none;">{c.label}</a>
        ) : (
          <span aria-current="page" style="color: var(--color-ink-900);">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
