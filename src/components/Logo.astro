---
/**
 * Logo — Al Azhar Tex brand mark.
 * The brand mark is the operator-supplied PHOENIX logo, shipped as two
 * transparent PNGs: a dark (navy + red) version for light surfaces and a
 * recoloured light version for dark surfaces. The wordmark text sits
 * beside the mark and adapts to the surface via the `tone` prop.
 * Reusable in Header + Footer + Hero.
 */
import { COMPANY } from '../data/company';

export interface Props {
  /** pixel size (height) of the mark */
  size?: number;
  /** show the wordmark next to the mark */
  wordmark?: boolean;
  /** tone: 'light' for dark backgrounds, 'dark' for light backgrounds */
  tone?: 'light' | 'dark';
  /** monogram text under/over the mark */
  showText?: boolean;
}

const { size = 44, wordmark = true, tone = 'dark', showText = true } = Astro.props;

const markColor = tone === 'light' ? 'var(--color-sand-50)' : 'var(--color-ink-900)';
const accent = 'var(--color-giza)';
const subColor = tone === 'light' ? 'rgba(247,243,236,0.7)' : 'var(--color-ink-500)';
// pick the logo variant that contrasts with the surface
const logoSrc = tone === 'light' ? '/logo-light.png' : '/logo.png';
const logoAlt = `${COMPANY.name} logo`;
---

<span
  class="azt-logo"
  style={`display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;`}
>
  <img
    src={logoSrc}
    alt={logoAlt}
    height={size}
    style={`display: block; height: ${size}px; width: auto; max-width: 100%; object-fit: contain;`}
  />
  {wordmark && showText && (
    <span class="azt-logo-text" style="display: flex; flex-direction: column; line-height: 1;">
      <span
        class="azt-logo-ar"
        style={`font-family: var(--font-naskh); font-weight: 700; font-size: ${Math.max(1.05, size * 0.032)}rem; color: ${markColor};`}
      >{COMPANY.nameAr}</span>
      <span
        class="azt-logo-en azt-mono"
        style={`font-size: ${Math.max(0.62, size * 0.018)}rem; letter-spacing: 0.16em; color: ${subColor}; margin-block-start: 3px;`}
      >AL AZHAR TEX</span>
    </span>
  )}
</span>

<style>
  .azt-logo {
    display: inline-flex;
    align-items: center;
  }
  .azt-logo img {
    height: var(--azt-logo-size, 44px);
    width: auto;
  }
</style>
