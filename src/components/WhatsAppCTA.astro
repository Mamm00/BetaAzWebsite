---
/**
 * WhatsAppCTA — deep-linked, prefilled, both numbers available (§20).
 */
import { COMPANY } from '../data/company';
import { t } from '../lib/i18n';
import { waLinkFor } from '../lib/wa';
import type { Locale } from '../lib/url';

export interface Props {
  locale: Locale;
  text: string;
  phone?: string;
  variant?: 'solid' | 'ghost';
}

const { locale, text, phone, variant = 'solid' } = Astro.props;
---

<a
  class={variant === 'solid' ? 'azt-btn' : 'azt-btn azt-btn-ghost'}
  href={waLinkFor(text, phone ?? COMPANY.whatsapp[0])}
  target="_blank"
  rel="noopener"
  style={variant === 'solid' ? 'background: var(--color-ok); border-color: var(--color-ok);' : ''}
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.5A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.2l-.3-.2-2.9.9.9-2.8-.2-.3A8 8 0 1 1 12 20Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.6-.2-1.3-.5-1.9-.9-.4-.2-.8-.5-1.2-.8-.1-.1-.3-.2-.5-.1-.2.1-.4.2-.5.3-.2.2-.7.7-.9 1-.1.2 0 .4 0 .5l.6 1.8c.2.6.8 1.2 1.2 1.5.1.1.2.2.3.2.1 0 .2 0 .3-.1l.7-.8c.2-.2.4-.2.5-.1.2.1.3.2.4.3l.2.3c.1.1.1.2.2.3 0 .1-.1.2-.1.3l-.3.8c-.1.2-.1.4 0 .5l.3.6c.1.1.2.2.2.3 0 .1-.1.2-.1.3-.1.2-.2.4-.1.6l.1.3c0 .1.1.2.2.2h.2c.1 0 .2 0 .2-.1l.5-.6c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.1.5 0 .1-.1.2-.2.3-.3l.8-.7c.2-.2.3-.2.5-.1.2.1.3.2.4.4l.3.5c.1.2.1.4 0 .5l-.3.8c-.1.2-.2.3-.4.4-.1.1-.3.1-.5 0l-.8-.5c-.2-.1-.4-.1-.6 0Z" />
  </svg>
  {t(locale, 'wa.label')}
</a>
