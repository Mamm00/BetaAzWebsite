---
/**
 * DirectionsLink — map loads on click, nothing stored (§10 gallery, §16).
 */
import { COMPANY } from '../data/company';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/url';

export interface Props {
  locale: Locale;
  query?: string;
}

const { locale, query } = Astro.props;
const q = query ?? 'Ziraa, Zagazig, Sharkia, Egypt';
const mapUrl = `https://www.openstreetmap.org/search?query=${encodeURIComponent(q)}`;
---

<a
  class="azt-btn azt-btn-ghost"
  href={mapUrl}
  target="_blank"
  rel="noopener"
  style="min-height: 44px;"
  data-map-cta
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
    <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" />
    <circle cx="12" cy="10" r="2.5" />
  </svg>
  {t(locale, 'gallery.mapCta')}
</a>
