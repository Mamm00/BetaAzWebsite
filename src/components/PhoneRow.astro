---
/**
 * PhoneRow — large tappable phone row for gallery/contact (§10).
 */
import { t } from '../lib/i18n';
import type { Locale } from '../lib/url';

export interface Props {
  display: string;
  href: string;
  locale: Locale;
}

const { display, href, locale } = Astro.props;
---

<a href={href} class="azt-phone-row" style="display: flex; align-items: center; gap: 14px; padding: 14px 0; border-block-start: 1px solid var(--azt-hairline); text-decoration: none; color: inherit; min-height: 44px;">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />
  </svg>
  <span class="azt-mono" style="font-size: 1.05rem;">{display}</span>
  <span class="azt-visually-hidden">{locale === 'ar' ? 'اتصل' : 'Call'}</span>
</a>

<style>
  .azt-phone-row:hover {
    background: var(--color-sand-100);
  }
  .azt-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
