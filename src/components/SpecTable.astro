---
/**
 * SpecTable — mono spec table with hidden data semantics for charts;
 * here, plain definition list of specifications (§11).
 */
import { t } from '../lib/i18n';
import type { Locale } from '../lib/url';

export interface Row {
  label: string;
  value: string;
}

export interface Props {
  locale: Locale;
  rows: Row[];
}

const { locale, rows } = Astro.props;
---

<dl class="azt-spec-table" style="margin: 0; display: grid; grid-template-columns: minmax(120px, 220px) 1fr; gap: 0; border: 1px solid var(--azt-hairline); border-radius: var(--azt-radius); overflow: hidden;">
  {rows.map((row) => (
    <>
      <dt style="padding: 12px 16px; background: var(--color-sand-100); font-size: 0.85rem; color: var(--color-ink-700); border-block-end: 1px solid var(--azt-hairline);">{row.label}</dt>
      <dd style="padding: 12px 16px; margin: 0; font-size: 0.9rem; border-block-end: 1px solid var(--azt-hairline);">{row.value}</dd>
    </>
  ))}
</dl>

<style>
  @media (max-width: 640px) {
    .azt-spec-table {
      grid-template-columns: 1fr;
    }
    .azt-spec-table dt {
      border-block-end: none;
      padding-block-end: 0;
    }
  }
</style>
