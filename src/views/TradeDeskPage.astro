---
/**
 * TradeDeskPage (§10) — Saved lots, Sample list, Quotes, Downloads tabs,
 * behind role gating (§8/#1 Trade Desk).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';
import { locUrl, type Locale } from '../lib/url';
import Breadcrumb from '../components/Breadcrumb.astro';
import TradeDeskApp from '../components/TradeDeskApp.tsx';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={`${t(locale, 'trade.title')} · ${t(locale, 'nav.tradeDesk')}`}
  description={t(locale, 'trade.subtitle')}
  path="trade-desk"
>
  <div class="azt-container" style="padding-block: 40px 96px;">
    <Breadcrumb locale={locale} crumbs={[{ label: locale === 'ar' ? 'الرئيسية' : 'Home', href: '' }, { label: t(locale, 'nav.tradeDesk') }]} />
    <h1 style="margin: 0;">{t(locale, 'trade.title')}</h1>
    <p style="color: var(--color-ink-700); margin-top: 8px; max-width: 64ch;">{t(locale, 'trade.subtitle')}</p>
    <div style="margin-block-start: 32px;">
      <TradeDeskApp locale={locale} client:load />
    </div>
    <p style="margin-block-start: 24px;">
      <a href={locUrl(locale, 'sample-list')} style={`color: var(--color-indigo); text-decoration: none; border-block: 1px solid var(--azt-hairline); padding: 8px 12px; border-radius: var(--azt-radius);`}>
        → {t(locale, 'nav.sampleList')}
      </a>
    </p>
  </div>
</BaseLayout>
