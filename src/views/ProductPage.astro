---
/**
 * ProductPage (§10) — sticky media column, Grade Notes above the fold,
 * mono spec table, tabs, sticky mobile bar, related fabrics, Product JSON-LD.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { media } from '../assets/media';
import { fabricArt } from '../lib/fabricArt';
import { t } from '../lib/i18n';
import { locUrl, absUrl, type Locale } from '../lib/url';
import { getFabric, relatedFabrics, priceLabel, getGrade, grades } from '../lib/content';
import { waLink } from '../lib/wa';
import { COMPANY } from '../data/company';
import Breadcrumb from '../components/Breadcrumb.astro';
import GradeChip from '../components/GradeChip.astro';
import RenderTag from '../components/RenderTag.astro';
import StatusPill from '../components/StatusPill.astro';
import ShadeSwatch from '../components/ShadeSwatch.astro';
import SpecTable from '../components/SpecTable.astro';
import GradeComparisonStrip from '../components/GradeComparisonStrip.astro';
import FabricCard from '../components/FabricCard.astro';
import StickyActionBar from '../components/StickyActionBar.astro';
import Tabs from '../components/Tabs.astro';
import ARHoldOverlay from '../components/ARHoldOverlay.tsx';
import VisualiseButton from '../components/VisualiseButton.tsx';
import type { Fabric } from '../lib/schema';

export interface Props {
  locale: Locale;
  fabric: Fabric;
}

const { locale, fabric } = Astro.props;
const gradeDef = getGrade(fabric.grade)!;
const photoUrl = media(fabric.photo);
const alternatives = fabric.alternatives.map((s) => getFabric(s)).filter((x): x is Fabric => Boolean(x));

const specRows = [
  { label: t(locale, 'product.composition'), value: fabric.composition },
  { label: t(locale, 'product.gsm'), value: `${fabric.gsm} g/m²` },
  { label: t(locale, 'product.width'), value: `${fabric.widthCm} cm` },
  { label: t(locale, 'product.construction'), value: locale === 'ar' ? fabric.construction.ar : fabric.construction.en },
  { label: t(locale, 'product.finish'), value: locale === 'ar' ? fabric.finish.ar : fabric.finish.en },
  { label: t(locale, 'product.availability'), value: fabric.availability === 'in-stock' ? t(locale, 'catalog.inStock') : fabric.availability === 'low-stock' ? t(locale, 'catalog.lowStock') : t(locale, 'catalog.outOfStock') },
  { label: t(locale, 'product.moq'), value: `${fabric.moqM} ${t(locale, 'common.metres')}` },
  { label: t(locale, 'product.price'), value: `${priceLabel(fabric.pricePerMetre, locale)} / ${t(locale, 'common.metresShort')}` },
  { label: t(locale, 'product.buyer'), value: locale === 'ar' ? gradeDef.typicalBuyer.ar : gradeDef.typicalBuyer.en },
];

const productJsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: locale === 'ar' ? fabric.name.ar : fabric.name.en,
  description: locale === 'ar' ? `${fabric.name.ar} — درجة ${fabric.grade}` : `${fabric.name.en} — grade ${fabric.grade}`,
  sku: fabric.code,
  offers: { '@type': 'Offer', priceCurrency: 'EGP', price: (fabric.pricePerMetre / 100).toFixed(2), priceSpecification: { '@type': 'UnitPriceSpecification', price: fabric.pricePerMetre / 100, unitText: 'EGP', unit: 'https://schema.org/Meter' }, availability: fabric.availability === 'in-stock' ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock' },
};

const breadcrumbJsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: locale === 'ar' ? 'الرئيسية' : 'Home', item: absUrl(`${locale}/`, Astro.site!.toString()) },
    { '@type': 'ListItem', position: 2, name: t(locale, 'nav.fabrics'), item: absUrl(`${locale}/fabrics`, Astro.site!.toString()) },
    { '@type': 'ListItem', position: 3, name: locale === 'ar' ? fabric.name.ar : fabric.name.en, item: absUrl(`${locale}/fabrics/${fabric.slug}`, Astro.site!.toString()) },
  ],
};

const waText =
  fabric.grade === 'C'
    ? `مرحباً، عايز أعرف تفاصيل الدفعة ${fabric.code} (درجة C) والسعر للكمية.`
    : `مرحباً الأزهر تكس، مهتم بـ ${fabric.code} — ${fabric.name.ar} (درجة ${fabric.grade})، كمية ${fabric.moqM} متر. متاح؟`;
---

<BaseLayout
  locale={locale}
  title={`${locale === 'ar' ? fabric.name.ar : fabric.name.en} · ${fabric.grade} · ${COMPANY.nameAr}`}
  description={locale === 'ar' ? `${fabric.name.ar} — ${gradeDef.description.ar}` : `${fabric.name.en} — ${gradeDef.description.en}`}
  path={`fabrics/${fabric.slug}`}
  type="product"
  extraJsonld={[productJsonld, breadcrumbJsonld]}
>
  <div class="azt-container" style="padding-block: 28px 80px;">
    <Breadcrumb
      locale={locale}
      crumbs={[
        { label: locale === 'ar' ? 'الرئيسية' : 'Home', href: '' },
        { label: t(locale, 'nav.fabrics'), href: 'fabrics' },
        { label: locale === 'ar' ? fabric.name.ar : fabric.name.en },
      ]}
    />

    <div class="azt-grid" style="grid-template-columns: 5fr 7fr; gap: 48px; align-items: start;">
      <!-- sticky media column -->
      <div class="azt-media-col" style="position: sticky; inset-block-start: 90px; display: flex; flex-direction: column; gap: 16px;">
        <figure class="azt-card" style="margin: 0; overflow: hidden; aspect-ratio: 4 / 5; position: relative;">
          {photoUrl ? (
            <Image src={photoUrl} alt={t(locale, 'product.alt.hero', { name: locale === 'ar' ? fabric.name.ar : fabric.name.en })} width={1200} height={1500} widths={[500, 800, 1000, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" format="avif" loading="eager" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
          ) : (
            <div set:html={fabricArt({ seed: fabric.seed ?? 0, shade: fabric.shades[0]?.hex ?? '#C8A45C', grade: fabric.grade, construction: fabric.composition, w: 1200, h: 1500 })} style="width: 100%; height: 100%;" />
          )}
          <div style="position: absolute; inset-block-start: 12px; inset-inline-start: 12px; display: flex; gap: 8px; flex-wrap: wrap;">
            <GradeChip grade={fabric} locale={locale} />
            {fabric.source === 'render' && <RenderTag locale={locale} />}
          </div>
        </figure>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <ARHoldOverlay fabric={fabric} locale={locale} client:visible />
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          {fabric.shades.map((s) => (
            <ShadeSwatch ar={s.ar} en={s.en} hex={s.hex} locale={locale} />
          ))}
        </div>
      </div>

      <!-- content -->
      <div>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-block-end: 12px;">
          <GradeChip grade={fabric} locale={locale} />
          <span class="azt-mono azt-grade-c" style="font-size: 0.8rem;">{fabric.code}</span>
          <StatusPill status={fabric.availability} locale={locale} />
        </div>
        <h1 style="margin: 0 0 8px;">{locale === 'ar' ? fabric.name.ar : fabric.name.en}</h1>
        <p class="azt-mono" style="margin: 0 0 20px; color: var(--color-ink-500);">
          {fabric.composition} · {fabric.gsm} g/m² · {fabric.widthCm} cm
        </p>

        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-block-end: 32px;">
          <a class="azt-btn" href={waLink(waText)} target="_blank" rel="noopener">{t(locale, 'product.waInquire')}</a>
          <VisualiseButton fabric={fabric} locale={locale} client:visible />
        </div>

        <!-- Grade Notes above the fold -->
        <section class="azt-cv" aria-labelledby="grade-notes-h">
          <h2 id="grade-notes-h" style="font-size: 1.2rem;">{t(locale, 'product.gradeNotes')}</h2>
          <p style="color: var(--color-ink-700); margin-top: 0;">{locale === 'ar' ? gradeDef.description.ar : gradeDef.description.en}</p>
          <ul style="display: grid; gap: 8px; padding-inline-start: 20px; color: var(--color-ink-700);">
            {(locale === 'ar' ? fabric.gradeNotes.ar : fabric.gradeNotes.en).map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <div style="margin-block-start: 24px;">
            <h3 style="font-size: 1rem; margin-block-start: 0;">{t(locale, 'grades.compareTitle')}</h3>
            <GradeComparisonStrip locale={locale} grades={grades} seed={fabric.seed ?? 42} shade={fabric.shades[0]?.hex ?? '#C8A45C'} composition={fabric.composition} />
          </div>
        </section>

        <Tabs tabs={[{ id: 'details', label: t(locale, 'product.detailsTab') }, { id: 'shades', label: t(locale, 'product.shadeTab') }, { id: 'gallery', label: t(locale, 'product.galleryTab') }]}>
          <div slot="details" class="azt-cv">
            <h2 style="font-size: 1.2rem;">{t(locale, 'product.specs')}</h2>
            <SpecTable locale={locale} rows={specRows} />
            {alternatives.length > 0 && (
              <div style="margin-block-start: 32px;">
                <h3 style="font-size: 1rem;">{t(locale, 'product.related')}</h3>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                  {alternatives.map((a) => (
                    <a class="azt-chip" href={locUrl(locale, `fabrics/${a.slug}`)} style="text-decoration: none; color: inherit;">
                      <GradeChip grade={a} locale={locale} size="sm" /> {locale === 'ar' ? a.name.ar : a.name.en}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
          <div slot="shades" class="azt-cv">
            <h2 style="font-size: 1.2rem;">{t(locale, 'product.shadeTab')}</h2>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              {fabric.shades.map((s) => (
                <div class="azt-card" style="padding: 12px; display: grid; gap: 8px; justify-items: center; width: 140px;">
                  <span style={`display: inline-block; width: 80px; height: 80px; border-radius: var(--azt-swatch-radius); background: ${s.hex}; border: 1px solid var(--azt-hairline);`}></span>
                  <span class="azt-mono" style="font-size: 0.78rem;">{locale === 'ar' ? s.ar : s.en}</span>
                  <span class="azt-mono" style="font-size: 0.68rem; color: var(--color-ink-500);">{s.hex}</span>
                </div>
              ))}
            </div>
          </div>
          <div slot="gallery" class="azt-cv">
            <h2 style="font-size: 1.2rem;">{t(locale, 'product.galleryTab')}</h2>
            {photoUrl ? (
              <Image src={photoUrl} alt={t(locale, 'product.alt.macro', { name: locale === 'ar' ? fabric.name.ar : fabric.name.en })} width={1600} height={1000} widths={[800, 1200, 1600]} sizes="(min-width: 1024px) 60vw, 100vw" format="avif" loading="lazy" decoding="async" style="width: 100%; border-radius: var(--azt-radius); border: 1px solid var(--azt-hairline);" />
            ) : (
              <div set:html={fabricArt({ seed: (fabric.seed ?? 0) + 11, shade: fabric.shades[Math.min(1, fabric.shades.length - 1)]?.hex ?? '#C8A45C', grade: fabric.grade, construction: fabric.composition, w: 1600, h: 1000 })} style="aspect-ratio: 16 / 10; border-radius: var(--azt-radius); border: 1px solid var(--azt-hairline);" />
            )}
          </div>
        </Tabs>
      </div>
    </div>

    <!-- related fabrics -->
    <section class="azt-cv" style="margin-block-start: 72px;">
      <h2>{t(locale, 'product.related')}</h2>
      <div class="azt-grid" style="grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; margin-block-start: 24px;">
        {relatedFabrics(fabric, 4).map((f) => (
          <FabricCard fabric={f} locale={locale} />
        ))}
      </div>
    </section>
  </div>

  <StickyActionBar fabric={fabric} locale={locale} />
</BaseLayout>

<style>
  @media (max-width: 1024px) {
    .azt-grid {
      grid-template-columns: 1fr !important;
    }
    .azt-media-col {
      position: static !important;
    }
  }
</style>
